{
  "name": "vscode-translate-llm",
  "displayName": "VSTranslate",
  "description": "Translate code comments from any language to English using Ollama",
  "version": "0.2.0",
  "publisher": "samikool",
  "repository": {
    "type": "git",
    "url": "https://github.com/samikool/vscode-translate-llm"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vstranslate.translate",
        "title": "Show Translated Comments",
        "category": "VSTranslate"
      },
      {
        "command": "vstranslate.replaceComments",
        "title": "Replace Comments with Translation",
        "category": "VSTranslate"
      },
      {
        "command": "vstranslate.insertComments",
        "title": "Insert Translated Comments",
        "category": "VSTranslate"
      },
      {
        "command": "vstranslate.translateFile",
        "title": "Translate Whole File",
        "category": "VSTranslate"
      },
      {
        "command": "vstranslate.translateWorkspace",
        "title": "Translate Whole Workspace",
        "category": "VSTranslate"
      },
      {
        "command": "vstranslate.clearOverlay",
        "title": "Clear Translation Overlay",
        "category": "VSTranslate"
      },
      {
        "command": "vstranslate.selectModel",
        "title": "Select Ollama Model",
        "category": "VSTranslate"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "vstranslate.translate",
          "when": "editorHasSelection",
          "group": "vstranslate@1"
        },
        {
          "command": "vstranslate.replaceComments",
          "when": "editorHasSelection",
          "group": "vstranslate@2"
        },
        {
          "command": "vstranslate.insertComments",
          "when": "editorHasSelection",
          "group": "vstranslate@3"
        },
        {
          "command": "vstranslate.translateFile",
          "when": "editorIsOpen",
          "group": "vstranslate@4"
        },
        {
          "command": "vstranslate.translateWorkspace",
          "when": "editorIsOpen",
          "group": "vstranslate@5"
        }
      ]
    },
    "configuration": {
      "title": "VSTranslate",
      "properties": {
        "vstranslate.ollamaEndpoint": {
          "type": "string",
          "default": "http://127.0.0.1:11434",
          "description": "Base URL of the Ollama API endpoint"
        },
        "vstranslate.ollamaModel": {
          "type": "string",
          "default": "gpt-oss:20b",
          "description": "Ollama model to use for translation"
        },
        "vstranslate.ollamaApiKey": {
          "type": "string",
          "default": "",
          "description": "API key for Ollama (leave empty if not required)"
        },
        "vstranslate.overlayColor": {
          "type": "string",
          "default": "#4EC9B0",
          "description": "Color of the translation overlay text (hex value, e.g. #4EC9B0)"
        }
      }
    },
    "keybindings": [
      {
        "command": "vstranslate.translate",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "editorHasSelection"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^8.58.1",
    "@typescript-eslint/parser": "^8.58.1",
    "@vscode/vsce": "^3.7.1",
    "eslint": "^9.39.4",
    "typescript": "^5.3.0"
  }
}
